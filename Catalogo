      <div class="stat"><div class="n" id="statN">10</div><div class="l">Productos disponibles</div></div>
      <div class="stat"><div class="n">-10%</div><div class="l">En todo el catálogo</div></div>
      <div class="stat"><div class="n">2</div><div class="l">Ciudades · entrega directa</div></div>
    </div>
