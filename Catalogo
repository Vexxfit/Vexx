<script>
let DATA = JSON.parse(document.getElementById('vexx-data').textContent);
const grid = document.getElementById('grid');
const money = n => '$' + Math.round(n).toLocaleString('es-MX');
const finalPrice = p => Math.round(p.precio * (1 - (p.pct||0)/100));
let currentFilter = 'all';
let editIdx = null;

document.getElementById('igFoot').href = DATA.config.ig;

function render(){
  grid.innerHTML = '';
  DATA.productos.forEach((p,i)=>{
    if(currentFilter!=='all' && p.cat!==currentFilter) return;
    const agotado = (+p.stock||0) <= 0;
    const catClass = {'Proteína':'c-prot','Creatina':'c-crea','Pre-Workout':'c-pwo'}[p.cat]||'c-prot';
    const card = document.createElement('article');
    card.className='card';
    const media = p.img
      ? `<div class="ph-media"><img src="${p.img}" alt="${p.nombre}" loading="lazy" onerror="this.parentNode.innerHTML='<div class=&quot;ph-placeholder ph-media&quot;><span class=&quot;ph-soon&quot;>Foto próximamente</span></div>'">${agotado?'<div class="agotado-overlay"><span>AGOTADO</span></div>':''}</div>`
      : `<div class="ph-media ph-placeholder"><img class="iso" src="${document.getElementById('logoTop').src}" alt=""><span class="ph-soon">Foto próximamente</span>${agotado?'<div class="agotado-overlay"><span>AGOTADO</span></div>':''}</div>`;
    const stockNote = (!agotado && +p.stock<=2) ? `<p class="stock-note">⚡ Últimas ${p.stock} pieza${p.stock>1?'s':''}</p>` : '';
    card.innerHTML = `
      <button class="edit-btn" data-i="${i}">✎ Editar</button>
      ${media}
      <div class="card-body">
        <span class="pill ${catClass}">${p.cat}</span>
        <h3 class="card-name">${p.nombre}</h3>
        <p class="card-meta">${p.marca} · ${p.sabor}</p>
        <p class="card-desc">${p.desc||''}</p>
        ${stockNote}
        <div class="price-row">
          <div class="price-block">
            ${p.pct>0?`<span class="price-old">${money(p.precio)}</span>`:''}
            <span class="price-new">${money(finalPrice(p))}</span>
          </div>
          ${p.pct>0?`<span class="save-tag">-${p.pct}%</span>`:''}
        </div>
        <a class="card-cta ${agotado?'off':''}" href="${DATA.config.ig}" target="_blank" rel="noopener">${agotado?'Agotado':'Pedir por DM →'}</a>
      </div>`;
    grid.appendChild(card);
  });
  document.getElementById('statN').textContent = DATA.productos.filter(p=>+p.stock>0).length || DATA.productos.length;
  document.querySelectorAll('.edit-btn').forEach(b=>b.addEventListener('click',e=>{openEdit(+e.target.dataset.i)}));
}

document.querySelectorAll('.fbtn').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));
  b.classList.add('active'); currentFilter=b.dataset.f; render();
}));

/* ===== ADMIN ===== */
let clicks=0, clickTimer=null;
function logoTap(){
  clicks++; clearTimeout(clickTimer);
  clickTimer=setTimeout(()=>clicks=0,1600);
  if(clicks>=5){clicks=0; askPw();}
}
document.getElementById('logoTop').addEventListener('click',logoTap);
document.getElementById('logoBottom').addEventListener('click',logoTap);
if(location.hash==='#admin') setTimeout(askPw,300);

function askPw(){
  const pw = prompt('Clave de administrador:');
  if(pw===null) return;
  if(btoa(pw)===DATA.config.pw){ document.body.classList.add('admin'); document.getElementById('adminBar').style.display='block'; }
  else alert('Clave incorrecta');
}
document.getElementById('btnSalir').addEventListener('click',()=>{
  document.body.classList.remove('admin'); document.getElementById('adminBar').style.display='none';
});

/* Edit modal */
const M = id=>document.getElementById(id);
function openEdit(i){
  editIdx=i;
  const p = i===null? {nombre:'',marca:'',sabor:'',cat:'Proteína',desc:'',precio:0,pct:10,stock:1,img:''} : DATA.productos[i];
  M('mTitle').textContent = i===null?'Nuevo producto':'Editar producto';
  M('fNombre').value=p.nombre; M('fMarca').value=p.marca; M('fSabor').value=p.sabor;
  M('fCat').value=p.cat; M('fDesc').value=p.desc||'';
  M('fPrecio').value=p.precio; M('fPct').value=p.pct; M('fStock').value=p.stock;
  M('fImgUrl').value = (p.img&&p.img.startsWith('http'))?p.img:'';
  M('fImgFile').value='';
  M('fImgPrev').src = p.img||'';
  M('fImgPrev').style.display = p.img?'block':'none';
  updFinal();
  M('mEliminar').style.display = i===null?'none':'block';
  M('editModal').classList.add('open');
}
function updFinal(){
  const pr=+M('fPrecio').value||0, pct=+M('fPct').value||0;
  M('fFinal').textContent = 'Precio final: ' + money(Math.round(pr*(1-pct/100)));
}
M('fPrecio').addEventListener('input',updFinal);
M('fPct').addEventListener('input',updFinal);
M('fImgFile').addEventListener('change',e=>{
  const f=e.target.files[0]; if(!f)return;
  const r=new FileReader();
  r.onload=()=>{M('fImgPrev').src=r.result; M('fImgPrev').style.display='block'; M('fImgUrl').value='';};
  r.readAsDataURL(f);
});
M('fImgUrl').addEventListener('input',e=>{
  if(e.target.value){M('fImgPrev').src=e.target.value; M('fImgPrev').style.display='block';}
});
M('mCancelar').addEventListener('click',()=>M('editModal').classList.remove('open'));
M('mGuardar').addEventListener('click',()=>{
  const p = {
    id: editIdx===null ? 'PROD-'+Date.now() : DATA.productos[editIdx].id,
    nombre:M('fNombre').value.trim(), marca:M('fMarca').value.trim(), sabor:M('fSabor').value.trim(),
    cat:M('fCat').value, desc:M('fDesc').value.trim(),
    precio:+M('fPrecio').value||0, pct:+M('fPct').value||0, stock:+M('fStock').value||0,
    img: M('fImgUrl').value.trim() || (M('fImgPrev').style.display!=='none'?M('fImgPrev').src:'')
  };
  if(!p.nombre){alert('Pon un nombre');return;}
  if(editIdx===null) DATA.productos.push(p); else DATA.productos[editIdx]=p;
  M('editModal').classList.remove('open'); render();
});
M('mEliminar').addEventListener('click',()=>{
  if(editIdx!==null && confirm('¿Eliminar este producto?')){
    DATA.productos.splice(editIdx,1);
    M('editModal').classList.remove('open'); render();
  }
});
document.getElementById('btnAgregar2').addEventListener('click',()=>openEdit(null));

/* Download updated HTML */
document.getElementById('btnDescargar').addEventListener('click',()=>{
  document.getElementById('vexx-data').textContent = JSON.stringify(DATA);
  const wasAdmin = document.body.classList.contains('admin');
  document.body.classList.remove('admin');
  document.getElementById('adminBar').style.display='none';
  grid.innerHTML='';
  const html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  render();
  if(wasAdmin){document.body.classList.add('admin'); document.getElementById('adminBar').style.display='block';}
  const blob = new Blob([html],{type:'text/html'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'catalogo_vexx.html';
  a.click();
  URL.revokeObjectURL(a.href);
});

render();
</script>
</body>
</html>
