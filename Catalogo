    </div>
    <a class="foot-cta" id="igFoot" href="#" target="_blank" rel="noopener">
      <svg class="plane" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      Escríbenos por DM
    </a>
  </div>
  <div class="sig">
    <img id="logoBottom" src="data:image/png;base64," alt="VEXX">
    <span>Precios en MXN · sujetos a disponibilidad · 2026</span>
  </div>
</footer>

<div id="editModal">
  <div class="modal-box">
    <h3 id="mTitle">Editar producto</h3>
    <label>Nombre</label><input id="fNombre">
